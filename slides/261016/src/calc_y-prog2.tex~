\documentclass[dvipdfmx]{jarticle}
\pagestyle{empty}
\usepackage{fancyvrb}
\begin{document}
\begin{Verbatim}
  expr:
  NUMBER          { $$ = $1; }
  | expr '+' expr   { $$ = $1 + $3; }
  | expr '-' expr   { $$ = $1 - $3; }
  | expr '*' expr   { $$ = $1 * $3; }
  | expr '/' expr   {
      if ($3 == 0) {
          yyerror("division by zero");
          $$ = 0;
        } else {
          $$ = $1 / $3;
        }
    }
  | '-' expr %prec UMINUS { $$ = -$2; }
  | '(' expr ')'    { $$ = $2; }
  ;

  %%

  void yyerror(const char *s) {
      fprintf(stderr, "Error: %s\n", s);
    }

  int main(void) {
      setvbuf(stdout, NULL, _IONBF, 0);

      printf("電卓プログラム (Ctrl+D または Ctrl+C で終了)\n> ");
      return yyparse();
    }
\end{Verbatim}
\end{document}
